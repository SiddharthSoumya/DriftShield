#!/bin/bash
set -euo pipefail
cd /opt/driftshield/current
set -a
source /etc/driftshield/service.env
set +a
if [[ -r release.sha ]]; then
  read -r DS_RELEASE_SHA < release.sha
  export DS_RELEASE_SHA
fi
case "${1:-}" in
  web) exec .venv/bin/gunicorn driftshield.wsgi:application --bind 127.0.0.1:8000 --no-control-socket --workers 2 --timeout 45 --access-logfile - --access-logformat '%(h)s %(m)s %(U)s %(s)s %(D)s' ;;
  worker) exec .venv/bin/python manage.py work ;;
  manage) shift; exec .venv/bin/python manage.py "$@" ;;
  *) exit 2 ;;
esac
