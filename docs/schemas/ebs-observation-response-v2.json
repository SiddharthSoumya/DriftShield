{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "coverage",
    "delivery"
  ],
  "properties": {
    "status": {
      "enum": [
        "unbaselined",
        "match",
        "drift",
        "awaiting_confirmation",
        "partial",
        "failed"
      ]
    },
    "coverage": {
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "delivery": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f-]{36}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "coverage": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "unbaselined",
              "match",
              "drift",
              "awaiting_confirmation"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage": {
            "const": "partial"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "partial"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "failed"
            ]
          }
        }
      }
    }
  ]
}
